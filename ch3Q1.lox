// random functions

class Cat {
  aCat() {
    print "its a cat";
  }
}

class Kitten < Cat {
  aKitten() {
    print "its a tiny cat";
  }
}

class Fish < Kitten {
  aFish() {
    print "a kitten stares at the fish";
  }
}

var theFish = Fish();
theFish.aCat(); 
theFish.aKitten(); 
theFish.aFish(); 

