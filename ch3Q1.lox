var testBool = true;
var a = 1;

fun printSum(a, b) {
  print a + b;
}

print "Hello, world!";
print sum1;

if (testBool) {
  print "yes";
} else {
  print "no";
}

while (a < 5) {
  print a;
  a = a + 1;
}

for (var a = 1; a < 3; a = a + 1) {
  print a;
}

printSum(a, num1);

